# Required: used by the agent pipeline (web search + web fetch + synthesis + verification)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model override. Must support the web_search and web_fetch server tools.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: lets the probe stage check whether Composio already provides a managed OAuth app.
# Get one from https://platform.composio.dev . Without it the guide says "unknown" and links to the toolkit page.
# COMPOSIO_API_KEY=

# Optional: persistent cache for live-generated guides (Upstash Redis). Without it, an in-memory cache is used
# (fine for local dev and demos; resets on cold start).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: protect the public /api/generate endpoint from abuse during the demo.
# Set a shared secret and pass it as ?key= or the x-generate-key header. Leave empty to allow all.
# GENERATE_KEY=
# Max live generations per hour per IP (default 6)
# GENERATE_RATE_LIMIT=6

# Optional: run the pipeline with fixture responses instead of the model (no key needed).
# Fixtures: Linear, Notion, HubSpot, Cal.com, Mercury, Resend; anything else gets a low-confidence generic guide.
# The deployed demo runs with this set. Remove it once ANTHROPIC_API_KEY is configured.
# MOCK_AGENT=1
